rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }
    
    // Users collection
    match /users/{userId} {
      // Allow users to read their own document or admins to read all
      allow read: if isAuthenticated();
      // Allow user creation during registration / OAuth login
      allow create: if isAuthenticated();
      // Allow users to update their own document, admins can update any
      allow update: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // Families collection
    match /families/{familyId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Festivals collection
    match /festivals/{festivalId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Payments collection (Chanda Contributions)
    match /payments/{paymentId} {
      allow read: if isAuthenticated();
      // Allow authenticated members to record payments (which enter verification queue)
      allow create: if isAuthenticated();
      // Only admins can verify or update payments
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Receipts collection (Receipts and Provisional Slips)
    match /receipts/{receiptId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Expenses collection (Vendor bills and Out-of-pocket expenses)
    match /expenses/{expenseId} {
      allow read: if isAuthenticated();
      // Allow authenticated members to record out-of-pocket or master account expense requests
      allow create: if isAuthenticated();
      // Only admins can approve or edit expenses
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Invoices collection (for expense invoices)
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // User Accounts collection (Personal Ledgers)
    match /user_accounts/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Reimbursement Requests collection
    match /reimbursement_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }
    
    // Account collection (Main treasury balance)
    match /account/{accountId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false; // Never delete account
    }
    
    // Transactions collection (Main account audit history)
    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if false; // Transactions are immutable
      allow delete: if isAdmin();
    }
  }
}
